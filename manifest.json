{
  "manifest_version": 3,
  "name": "MPG – Thème et correctifs UI",
  "version": "1.7.0",
  "description": "Bandeaux mosaïque animés par page, thème ardoise et correctifs UX / accessibilité sur mpg.football.",
  "homepage_url": "https://github.com/frank-mpg/extension_ui_improvements",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MPG – Thème et correctifs UI"
  },
  "background": {
    "service_worker": "autoreload.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mpg.football/*"
      ],
      "js": [
        "theme.js",
        "banner.js",
        "fixes.js"
      ],
      "run_at": "document_start"
    }
  ]
}
